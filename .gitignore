# ── dependencies ─────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── next.js ──────────────────────────────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ── testing ──────────────────────────────────────────────────────────────
/coverage
/test-results
/playwright-report

# ── env ──────────────────────────────────────────────────────────────────
# Never commit real keys. .env.example documents the shape instead.
.env
.env.*
!.env.example

# ── supabase ─────────────────────────────────────────────────────────────
/supabase/.temp/

# ── image pipeline ───────────────────────────────────────────────────────
# The exported assets live in /public and ARE committed. These are the heavy
# intermediates (~60MB): source renders, vendored tooling and font binaries.
# Regenerate with the scripts in output/imagegen.
/output/imagegen/originals/
/output/imagegen/tooling/
/output/imagegen/tooling-py/
/output/imagegen/fonts/
/output/imagegen/*-palette.png
/output/imagegen/*-review.png
/output/imagegen/review-*.jpg
/output/imagegen/reference-refresh/

# ── misc ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
